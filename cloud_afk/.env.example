# ==========================================
# 1. REQUIRED DISCORD CREDENTIALS
# ==========================================
# Your Discord User Account Token (keep this private!)
DISCORD_TOKEN=your_discord_token_here

# The Discord Server ID (Guild ID) where the room is located
GUILD_ID=123456789012345678

# The Voice Channel ID (or AFK room ID) to join
CHANNEL_ID=123456789012345678

# Automatically mute and deafen your account upon joining (recommended: true)
SELF_MUTE=true
SELF_DEAF=true

# ==========================================
# 2. OPTIONAL: 24/7 ACTIVITY WHILE PC IS OFFLINE
# ==========================================
# Your account status: online, idle, or dnd
ACTIVITY_STATUS=online

# What game/app Discord says you are playing:
ACTIVITY_NAME=Visual Studio Code

# Activity Type: 0 = Playing, 1 = Streaming (purple icon), 2 = Listening, 3 = Watching
ACTIVITY_TYPE=0

# Details & State shown under your name
ACTIVITY_DETAILS=Coding 24/7
ACTIVITY_STATE=In Voice Channel

# Optional Twitch URL if ACTIVITY_TYPE=1 (Streaming)
STREAM_URL=https://twitch.tv/discord

# Port for cloud health check (Render.com default is 10000)
PORT=10000
